<style>
       body{
         display: grid;
         grid-template-areas: "header header" "main main " "sideads sideads" "footer footer";
         grid-template-rows: 205 1fr;
         grid-template-columns: 70% 1fr;
         gap: 20px;
         height: 70vh;
         width: 80%;
    }
   header,article,div,footer {
    background-color: burlywood;
    padding: 20px;
   }
 #header{
    grid-area: header;
 }
 #article{
    grid: main;
 }
 #sideads{
    grid-area: sideads;
 }
 #footer{
    grid-area: footer;
 }
</style>
<body>
